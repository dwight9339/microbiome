{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dwight9339/microbiome/tools/packc/pack.schema.json",
  "title": "microbiome pack",
  "description": "pack.yaml: a microbiome scene. Reference: docs/pack-format.md. packc is the authority; this schema mirrors what it accepts, and adds typo detection (packc ignores unknown keys).",
  "type": "object",
  "additionalProperties": false,
  "required": ["world"],
  "properties": {
    "name": { "type": "string", "description": "Display name of the pack." },
    "world": { "$ref": "#/$defs/world" },
    "clock": { "$ref": "#/$defs/clock" },
    "vars": {
      "type": "object",
      "description": "World variables. minute, hour, month and day are built in; at most 32 in total.",
      "maxProperties": 28,
      "propertyNames": { "not": { "enum": ["minute", "hour", "month", "day"] } },
      "additionalProperties": { "$ref": "#/$defs/var" }
    },
    "lighting": { "$ref": "#/$defs/lighting" },
    "layers": {
      "type": "array",
      "description": "Drawn back to front.",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/layer" }
    },
    "lanes": {
      "type": "object",
      "description": "Bands of feet-y that actors move within.",
      "additionalProperties": { "$ref": "#/$defs/intRange" }
    },
    "places": {
      "type": "object",
      "description": "Points in the world that offer affordances.",
      "additionalProperties": { "$ref": "#/$defs/place" }
    },
    "obstacles": {
      "type": "object",
      "description": "Areas walkers go around instead of through.",
      "maxProperties": 8,
      "additionalProperties": { "$ref": "#/$defs/obstacle" }
    },
    "actors": {
      "type": "object",
      "description": "Animal definitions.",
      "additionalProperties": { "$ref": "#/$defs/actor" }
    },
    "spawns": {
      "type": "array",
      "description": "Every spawning.interval, one eligible rule is picked by weight.",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/spawn" }
    },
    "particles": {
      "type": "object",
      "description": "Ambient particle systems (256 particles in total).",
      "maxProperties": 8,
      "additionalProperties": { "$ref": "#/$defs/particles" }
    }
  },

  "$defs": {
    "duration": {
      "description": "Seconds, or a string with a unit: 500ms, 4s, 2m, 1.5h.",
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^\\s*[0-9.]+\\s*(ms|s|m|h)?\\s*$" }
      ]
    },
    "durationRange": {
      "description": "A duration or [min, max].",
      "oneOf": [
        { "$ref": "#/$defs/duration" },
        { "type": "array", "prefixItems": [{ "$ref": "#/$defs/duration" }, { "$ref": "#/$defs/duration" }], "minItems": 2, "maxItems": 2 }
      ]
    },
    "timeOfDay": {
      "description": "Time of day \"HH:MM\" (quote it: unquoted, YAML reads 07:30 as a number, which packc also accepts).",
      "oneOf": [
        { "type": "string", "pattern": "^\\s*([01]?[0-9]|2[0-3]):[0-5][0-9]\\s*$" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "color": {
      "description": "\"#rrggbb\" or [r, g, b].",
      "oneOf": [
        { "type": "string", "pattern": "^\\s*#?[0-9a-fA-F]{6}\\s*$" },
        { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 3, "maxItems": 3 }
      ]
    },
    "numRange": {
      "description": "A number or [min, max].",
      "oneOf": [
        { "type": "number" },
        { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
      ]
    },
    "intRange": {
      "description": "An integer or [min, max].",
      "oneOf": [
        { "type": "integer" },
        { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
      ]
    },
    "point": {
      "description": "[x, y] in world pixels.",
      "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2
    },
    "nameOrList": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "scalar": { "type": ["string", "number"] },

    "condition": {
      "description": "All entries must hold (AND). var: value (equals), var: [values] (in), or var: {op: arg}.",
      "type": ["object", "null"],
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/scalar" },
          { "type": "array", "items": { "$ref": "#/$defs/scalar" } },
          {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "in":      { "oneOf": [{ "$ref": "#/$defs/scalar" }, { "type": "array", "items": { "$ref": "#/$defs/scalar" } }] },
              "not":     { "oneOf": [{ "$ref": "#/$defs/scalar" }, { "type": "array", "items": { "$ref": "#/$defs/scalar" } }] },
              "not_in":  { "oneOf": [{ "$ref": "#/$defs/scalar" }, { "type": "array", "items": { "$ref": "#/$defs/scalar" } }] },
              "eq":      { "$ref": "#/$defs/scalar" },
              "ne":      { "$ref": "#/$defs/scalar" },
              "lt":      { "$ref": "#/$defs/scalar" },
              "le":      { "$ref": "#/$defs/scalar" },
              "gt":      { "$ref": "#/$defs/scalar" },
              "ge":      { "$ref": "#/$defs/scalar" },
              "between": { "description": "[lo, hi], wrapping when lo > hi (e.g. 22:00..04:00).", "type": "array", "items": { "$ref": "#/$defs/scalar" }, "minItems": 2, "maxItems": 2 }
            }
          }
        ]
      }
    },

    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": { "description": "[width, height] in art pixels.", "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 }, "minItems": 2, "maxItems": 2 },
        "clear_color": { "$ref": "#/$defs/color", "description": "Letterbox and behind everything." },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/$defs/point", "description": "Initial camera centre." },
            "pan_speed": { "type": "integer", "minimum": 0, "description": "px/s while an arrow is held." },
            "idle_drift": { "$ref": "#/$defs/duration", "description": "Autopilot after this long without input; 0 = off." },
            "drift_speed": { "type": "number", "minimum": 0.1, "maximum": 25.5, "description": "Autopilot glide speed in px/s (default 3). Keep it low so the view changes without drawing attention." }
          }
        },
        "spawning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interval": { "$ref": "#/$defs/duration", "description": "How often to try spawning." },
            "chance": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Percent chance per try." },
            "max_actors": { "type": "integer", "minimum": 1, "maximum": 32, "description": "Global cap (engine max 32)." }
          }
        }
      }
    },

    "clock": {
      "type": "object",
      "description": "The simulated clock, used when the device has no real-time clock.",
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/timeOfDay" },
        "date": { "type": "string", "pattern": "^\\d{1,2}-\\d{1,2}$", "description": "MM-DD" },
        "day_length": { "$ref": "#/$defs/duration", "description": "Real time for one simulated day, e.g. 20m for a fast demo day." }
      }
    },

    "var": {
      "description": "A step function of an earlier variable, a Markov chain, or a constant (a bare number is shorthand for const).",
      "oneOf": [
        { "type": "number" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "table"],
          "properties": {
            "step": { "type": "string", "description": "Source variable (must be defined earlier)." },
            "table": {
              "type": "object", "minProperties": 1,
              "description": "Source value: result. String results become enum labels.",
              "additionalProperties": { "type": ["string", "integer"] }
            },
            "sensor": { "type": "string", "description": "A host sensor of this name overrides the value." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["markov"],
          "properties": {
            "markov": {
              "type": "object",
              "additionalProperties": false,
              "required": ["states"],
              "properties": {
                "step": { "$ref": "#/$defs/duration", "description": "Game time between rolls (default 30m)." },
                "states": {
                  "type": "object", "minProperties": 1,
                  "description": "state: {next_state: weight 0..255}. A row of all zeros stays put.",
                  "additionalProperties": {
                    "type": ["object", "null"],
                    "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 255 }
                  }
                }
              }
            },
            "sensor": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["const"],
          "properties": {
            "const": { "type": "integer" },
            "sensor": { "type": "string" }
          }
        }
      ]
    },

    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emissive": { "type": "array", "items": { "$ref": "#/$defs/color" }, "description": "Colours immune to darkness." },
        "keyframes": {
          "type": "array",
          "description": "Blended by time of day; wraps at midnight.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "at": { "$ref": "#/$defs/timeOfDay" },
              "brightness": { "type": "number", "minimum": 0 },
              "saturation": { "type": "number", "minimum": 0 },
              "tint": { "$ref": "#/$defs/color" },
              "tint_strength": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },

    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "name": { "type": "string" },
        "image": { "type": "string", "description": "PNG path relative to the pack directory." },
        "parallax": {
          "description": "auto (default), a number (0 = fixed to the screen, 1 = moves with the world), or [x, y].",
          "oneOf": [
            { "const": "auto" },
            { "type": "number" },
            { "type": "array", "items": { "oneOf": [{ "const": "auto" }, { "type": "number" }] }, "minItems": 2, "maxItems": 2 }
          ]
        },
        "at": { "$ref": "#/$defs/point", "description": "Offset in pixels." },
        "repeat_x": { "type": "boolean", "description": "Tile horizontally." },
        "front": { "type": "boolean", "description": "Draw over actors." }
      }
    },

    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at"],
      "properties": {
        "at": { "$ref": "#/$defs/point" },
        "offers": { "$ref": "#/$defs/nameOrList", "description": "Affordances (free-form, at most 32 per pack)." },
        "spread": { "type": "integer", "minimum": 0, "description": "Visitors pick a spot within +/- this many px in x." }
      }
    },

    "obstacle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "ellipse"],
      "properties": {
        "lane": { "type": "string" },
        "ellipse": { "description": "[x0, y0, x1, y1]: the box the ellipse fills, at most 1024 px per side.", "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 }
      }
    },

    "anim": {
      "description": "Frame list (shorthand) or {frames, fps | frame, loop}.",
      "oneOf": [
        { "$ref": "#/$defs/frames" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["frames"],
          "properties": {
            "frames": { "$ref": "#/$defs/frames" },
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "frame": { "$ref": "#/$defs/duration", "description": "Time per frame (default 125ms)." },
            "loop": { "type": "boolean" }
          }
        }
      ]
    },
    "frames": {
      "description": "Sprite-sheet cells, numbered left-to-right, top-to-bottom from 0: 3, [0, 1, 2], \"0-3\" or \"0-3,5\".",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^\\s*\\d+(\\s*-\\s*\\d+)?(\\s*,\\s*\\d+(\\s*-\\s*\\d+)?)*\\s*$" },
        { "type": "array", "minItems": 1, "items": { "oneOf": [
          { "type": "integer", "minimum": 0 },
          { "type": "string", "pattern": "^\\s*\\d+(\\s*-\\s*\\d+)?(\\s*,\\s*\\d+(\\s*-\\s*\\d+)?)*\\s*$" }
        ] } }
      ]
    },

    "state": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "anim": { "type": "string", "description": "Defaults to the state's own name if an anim has it." },
        "move": {
          "type": "string",
          "description": "idle | wander | seek <affordance> | exit | flee",
          "pattern": "^\\s*(idle|wander|exit|flee|seek(\\s+\\S+)+)\\s*$"
        },
        "duration": { "$ref": "#/$defs/durationRange", "description": "Required for idle. wander with a duration strolls until it expires." },
        "next": {
          "description": "{state: weight}, a single state, or a list of {to, weight, if}.",
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 255 } },
            { "type": "array", "items": { "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["to"],
                "properties": {
                  "to": { "type": "string" },
                  "weight": { "type": "integer", "minimum": 1, "maximum": 255 },
                  "if": { "$ref": "#/$defs/condition" }
                }
              }
            ] } }
          ]
        },
        "speed": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 16, "description": "Multiplier on the actor's speed." },
        "until": { "const": "arrive", "description": "A wander with a duration also ends when it reaches its target." },
        "then": { "const": "despawn", "description": "The actor disappears when the state ends." }
      },
      "anyOf": [
        { "type": "object", "required": ["duration"] },
        { "type": "object", "required": ["move"], "properties": { "move": { "not": { "pattern": "^\\s*idle\\s*$" } } } }
      ]
    },

    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheet", "frame", "anims", "states"],
      "properties": {
        "sheet": { "type": "string", "description": "Sprite sheet PNG (a grid of equal cells)." },
        "frame": { "description": "Cell size [w, h].", "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
        "anchor": { "$ref": "#/$defs/point", "description": "Feet within a cell; default bottom-centre." },
        "faces": { "enum": ["left", "right"], "description": "Direction the art faces (default right)." },
        "tags": { "$ref": "#/$defs/nameOrList", "description": "Free-form, at most 32 per pack." },
        "lane": { "type": "string" },
        "speed": { "type": "number", "minimum": 0, "description": "px/s" },
        "anims": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/anim" } },
        "states": {
          "type": "object", "minProperties": 1, "maxProperties": 254,
          "description": "Weighted random state machine; the first state is the initial one.",
          "additionalProperties": { "$ref": "#/$defs/state" }
        },
        "react": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to", "goto"],
            "properties": {
              "to": { "$ref": "#/$defs/nameOrList", "description": "Tags to react to." },
              "radius": { "type": "integer", "minimum": 0, "description": "px (default 48)" },
              "goto": { "type": "string", "description": "State to switch to." }
            }
          }
        },
        "leave": { "type": "string", "description": "State used when despawning." },
        "despawn_when": { "$ref": "#/$defs/condition" },
        "lifetime": { "$ref": "#/$defs/duration" }
      }
    },

    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor"],
      "properties": {
        "actor": { "type": "string" },
        "when": { "$ref": "#/$defs/condition" },
        "weight": { "type": "integer", "minimum": 0, "description": "Relative odds among eligible rules." },
        "max": { "type": "integer", "minimum": 1, "maximum": 255, "description": "Alive at once from this rule." },
        "count": { "$ref": "#/$defs/intRange", "description": "Group size." },
        "cooldown": { "$ref": "#/$defs/duration" },
        "enter": { "type": "string", "pattern": "^\\s*(edge|anywhere|place\\s+\\S+)\\s*$", "description": "edge | place <affordance> | anywhere (prefers off-camera)" }
      }
    },

    "particles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": { "$ref": "#/$defs/condition" },
        "count": { "type": "integer", "minimum": 0 },
        "color": { "$ref": "#/$defs/color" },
        "blink": { "type": "boolean" },
        "wander": { "type": "boolean" },
        "size": { "type": "integer", "minimum": 1, "description": "px" },
        "wobble": { "type": "integer", "minimum": 0, "description": "Horizontal sway amplitude, px." },
        "vx": { "$ref": "#/$defs/numRange", "description": "px/s" },
        "vy": { "$ref": "#/$defs/numRange", "description": "px/s" },
        "band": { "$ref": "#/$defs/intRange", "description": "World y range (default: the whole world)." },
        "above": { "type": "string", "description": "Draw right after this layer instead of on top of everything." }
      }
    }
  }
}
